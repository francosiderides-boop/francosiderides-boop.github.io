---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noIndexar>
  <div class="pad-x py-24 lg:py-[140px]">
    <div class="contenedor">
      <p class="eyebrow mb-3">Error 404</p>
      <h1 class="mb-6 font-display text-5xl leading-[.98] font-semibold md:text-[72px] lg:text-[104px]">
        Esta escena no está en el corte final.
      </h1>
      <p class="mb-8 max-w-[520px] text-muted">La página que buscás no existe o cambió de dirección.</p>
      <a href="/trabajos/" class="btn-primario">Ver trabajos</a>
    </div>
  </div>
</Base>
