---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import { sitio, enlaceWhatsApp, enlaceEmail } from '../lib/sitio';

const { contacto } = sitio;
const directos = [
  { etiqueta: 'WhatsApp', detalle: contacto.whatsappVisible, href: enlaceWhatsApp(), principal: true },
  { etiqueta: 'Email', detalle: contacto.email, href: enlaceEmail(), principal: false },
  ...sitio.redes.map((r) => ({ etiqueta: r.nombre, detalle: r.usuario, href: r.url, principal: false })),
];
---

<Base titulo="Contacto" descripcion={`${contacto.titulo} ${contacto.texto}`}>
  <div class="pad-x pt-8 pb-[72px] md:pt-14 md:pb-24 lg:pt-[72px] lg:pb-[140px]">
    <div class="contenedor">
      <p class="eyebrow mb-3">Contacto</p>
      <h1 class="mb-3 max-w-[820px] font-display text-5xl leading-[.98] font-semibold md:text-[72px] lg:text-[104px]">
        {contacto.titulo}
      </h1>
      <p class="mb-12 max-w-[520px] leading-normal text-muted md:mb-14 md:text-[17px] lg:mb-20 lg:text-lg">{contacto.texto}</p>

      <div class="grid grid-cols-1 items-start gap-12 md:gap-14 lg:grid-cols-2 lg:gap-20">
        <FormularioContacto />
        <section aria-labelledby="titulo-directo" class="flex flex-col gap-3">
          <h2 id="titulo-directo" class="mb-1 font-display text-[30px] font-semibold">Contacto directo</h2>
          <ul class="flex flex-col gap-3">
            {
              directos.map((d) => (
                <li>
                  <a
                    href={d.href}
                    target={d.href.startsWith('mailto:') ? undefined : '_blank'}
                    rel="noopener"
                    class:list={[
                      'flex min-h-14 flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-ui border px-5 py-2 font-bold transition-colors',
                      d.principal ? 'border-accent bg-accent text-onaccent hover:brightness-110' : 'border-line hover:border-fg',
                    ]}
                  >
                    <span>{d.etiqueta}</span>
                    <span class="font-normal break-all opacity-85">{d.detalle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>
