---
import { enlaceWhatsApp } from '../lib/sitio';
---

<!-- Botón flotante: visible en teléfono y tablet; en computadora el menú ya tiene "Contactame" -->
<a
  href={enlaceWhatsApp()}
  target="_blank"
  rel="noopener"
  aria-label="Escribir por WhatsApp"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-20 flex min-h-14 items-center gap-2.5 rounded-full bg-accent px-6 font-bold text-onaccent shadow-[0_8px_28px_rgba(0,0,0,.35)] md:right-6 md:bottom-6 lg:hidden"
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"
    ></path>
  </svg>
  WhatsApp
</a>
