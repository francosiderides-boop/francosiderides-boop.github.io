---
import { prepararImagen, datosImagen } from '../lib/imagenes';

interface Props {
  stills: (string | { src: string; alt?: string })[];
  carpeta: string;
  titulo: string;
  /** Stills verticales (9:16): grilla de más columnas y sin la primera imagen panorámica */
  vertical?: boolean;
}
const { stills, carpeta, titulo, vertical = false } = Astro.props;

const imagenes = (
  await Promise.all(
    stills.map(async (s, i) => {
      const { src, alt } = datosImagen(s);
      const img = await prepararImagen(src, carpeta);
      return img && { ...img, alt: alt || `${titulo}, still ${i + 1}` };
    }),
  )
).filter((x) => !!x);
---

{
  imagenes.length > 0 && (
    <section aria-labelledby="titulo-stills" class="mt-12 md:mt-14 lg:mt-20">
      <h2 id="titulo-stills" class="mb-5 font-display text-[32px] font-semibold">
        Stills
      </h2>
      <ul
        class:list={[
          'galeria grid',
          vertical ? 'grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4 lg:gap-6' : 'grid-cols-1 gap-7 md:grid-cols-2 md:gap-8 lg:grid-cols-3 lg:gap-9',
        ]}
      >
        {imagenes.map((img, i) => (
          <li class:list={[i === 0 && !vertical && 'md:col-span-2 lg:col-span-3']}>
            <button
              type="button"
              data-indice={i}
              data-src={img.src}
              data-srcset={img.srcset}
              data-alt={img.alt}
              class="group block w-full overflow-hidden rounded-ui bg-bg2"
              aria-label={`Ampliar imagen ${i + 1} de ${imagenes.length}: ${img.alt}`}
            >
              <img
                src={img.src}
                srcset={img.srcset || undefined}
                sizes={
                  vertical
                    ? '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'
                    : i === 0
                      ? '(min-width: 1440px) 1360px, 100vw'
                      : '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
                }
                width={img.width}
                height={img.height}
                alt=""
                loading="lazy"
                decoding="async"
                class:list={[
                  'w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]',
                  vertical ? 'aspect-[9/16]' : i === 0 ? 'aspect-[2.39/1]' : 'aspect-video',
                ]}
              />
            </button>
          </li>
        ))}
      </ul>
    </section>
  )
}

<!-- Lightbox: se abre al tocar una imagen. Flechas o deslizar para cambiar, Esc para cerrar. -->
<dialog
  id="lightbox"
  aria-label="Imagen ampliada"
  class="lightbox m-0 h-dvh max-h-none w-full max-w-none bg-black/95 p-0 text-[#ECEFF1]"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-4 py-3 md:px-6">
      <span data-contador class="text-[15px] font-medium" aria-live="polite"></span>
      <button type="button" data-cerrar class="flex min-h-12 items-center rounded-ui border border-white/30 px-4 font-semibold">
        Cerrar <span aria-hidden="true" class="ml-2">✕</span>
      </button>
    </div>
    <figure class="relative flex min-h-0 flex-1 items-center justify-center px-2 md:px-20">
      <img data-imagen alt="" class="max-h-full max-w-full touch-pan-y object-contain select-none" />
      <figcaption data-leyenda class="sr-only"></figcaption>
      <button
        type="button"
        data-anterior
        aria-label="Imagen anterior"
        class="absolute top-1/2 left-2 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-2xl md:left-5 md:size-14"
      >
        ←
      </button>
      <button
        type="button"
        data-siguiente
        aria-label="Imagen siguiente"
        class="absolute top-1/2 right-2 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-2xl md:right-5 md:size-14"
      >
        →
      </button>
    </figure>
    <div class="h-6 shrink-0"></div>
  </div>
</dialog>

<style>
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
</style>

<script>
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.galeria [data-indice]')];
  if (lb && botones.length) {
    const img = lb.querySelector<HTMLImageElement>('[data-imagen]')!;
    const leyenda = lb.querySelector<HTMLElement>('[data-leyenda]')!;
    const contador = lb.querySelector<HTMLElement>('[data-contador]')!;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + botones.length) % botones.length;
      const b = botones[actual];
      img.src = b.dataset.src!;
      if (b.dataset.srcset) img.srcset = b.dataset.srcset;
      img.sizes = '100vw';
      img.alt = b.dataset.alt!;
      leyenda.textContent = b.dataset.alt!;
      contador.textContent = `${actual + 1} / ${botones.length}`;
    };

    botones.forEach((b, i) =>
      b.addEventListener('click', () => {
        mostrar(i);
        lb.showModal();
      }),
    );
    lb.querySelector('[data-cerrar]')!.addEventListener('click', () => lb.close());
    lb.querySelector('[data-anterior]')!.addEventListener('click', () => mostrar(actual - 1));
    lb.querySelector('[data-siguiente]')!.addEventListener('click', () => mostrar(actual + 1));
    lb.addEventListener('close', () => botones[actual].focus());
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      if (e.key === 'ArrowRight') mostrar(actual + 1);
    });
    // Cerrar tocando el fondo oscuro
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).tagName === 'FIGURE') lb.close();
    });
    // Deslizar con el dedo en el teléfono
    let inicioX: number | null = null;
    img.addEventListener('pointerdown', (e) => (inicioX = e.clientX));
    img.addEventListener('pointerup', (e) => {
      if (inicioX === null) return;
      const dx = e.clientX - inicioX;
      if (Math.abs(dx) > 40) mostrar(actual + (dx < 0 ? 1 : -1));
      inicioX = null;
    });
  }
</script>
